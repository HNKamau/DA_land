                     &quot;high_mp_low_lp&quot;, &quot;high_mp_med_lp&quot;, &quot;high_mp_lp&quot;)

scenario_labels &lt;- c(
  low_mp          = &quot;Low maize price&quot;,
  med_mp          = &quot;Medium maize price&quot;,
  high_mp         = &quot;High maize price&quot;,
  low_lp          = &quot;Low lease price&quot;,
  med_lp          = &quot;Medium lease price&quot;,
  high_lp         = &quot;High lease price&quot;,
  low_mp_lp       = &quot;Low maize price and lease price&quot;,
  low_mp_med_lp   = &quot;Low maize price and medium lease price&quot;,
  low_mp_high_lp  = &quot;Low maize price and high lease price&quot;,
  med_mp_low_lp   = &quot;Medium maize price and low lease price&quot;,
  med_mp_lp       = &quot;Medium maize price and lease price&quot;,
  med_mp_high_lp  = &quot;Medium maize price and high lease price&quot;,
  high_mp_low_lp  = &quot;High maize price and low lease price&quot;,
  high_mp_med_lp  = &quot;High maize price and medium lease price&quot;,
  high_mp_lp      = &quot;High maize price and lease price&quot;)

change_summary &lt;- as_tibble(scen_values) %&gt;%
  mutate(across(everything(), \(v) v - baseline_lc)) %&gt;%   # per-run change vs baseline
  pivot_longer(everything(), names_to = &quot;scenario&quot;, values_to = &quot;change&quot;) %&gt;%
  group_by(scenario) %&gt;%
  summarise(p05    = quantile(change, 0.05, na.rm = TRUE),
            median = median(change, na.rm = TRUE),
            p95    = quantile(change, 0.95, na.rm = TRUE),
            .groups = &quot;drop&quot;) %&gt;%
  mutate(label     = scenario_labels[scenario],
         label     = factor(label, levels = rev(scenario_labels[scenario_order])),
         direction = ifelse(median &gt;= 0, &quot;More attractive&quot;, &quot;Less attractive&quot;))

