<pre class="r"><code># Standardise the combined scenario run to million KES per hectare.
land_consolidation_scenarios$y$net_benefit_lc_per_ha_MKes &lt;-
  land_consolidation_scenarios$y$net_benefit_lc_kes /
  land_consolidation_scenarios$x$ha_per_hh / 1e6

mcSimulation_results$y$net_benefit_lc_per_ha_MKes &lt;-
  mcSimulation_results$y$net_benefit_lc_kes /
  mcSimulation_results$x$ha_per_hh / 1e6
baseline_lc &lt;- mcSimulation_results$y$net_benefit_lc_per_ha_MKes

