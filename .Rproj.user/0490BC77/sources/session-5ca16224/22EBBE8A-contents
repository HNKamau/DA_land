## 6 NPV_per_ha_decision_pc    NA     NA     NA     NA    NA         33</code></pre>
<pre class="r"><code># (a) Overlaid densities of the two options (trimmed to the 5-95% range).
mc_output %&gt;%
  select(NPV_per_ha, No_NPV_per_ha) %&gt;%
  pivot_longer(everything(), names_to = &quot;variables&quot;, values_to = &quot;project_outcome&quot;) %&gt;%
  group_by(variables) %&gt;%
  filter(project_outcome &gt;= quantile(project_outcome, 0.05, na.rm = TRUE),
         project_outcome &lt;= quantile(project_outcome, 0.95, na.rm = TRUE)) %&gt;%
  ungroup() %&gt;%
  mutate(variables = factor(variables, levels = c(&quot;NPV_per_ha&quot;, &quot;No_NPV_per_ha&quot;),
                            labels = c(&quot;Land consolidation&quot;, &quot;Maintain farms&quot;))) %&gt;%
  ggplot(aes(project_outcome / 1e6, colour = variables, fill = variables)) +
  geom_density(alpha = 0.3) +
  scale_colour_manual(values = pal_decision) +
  scale_fill_manual(values = pal_decision) +
  labs(x = &quot;NPV per hectare (million KES)&quot;, y = &quot;Density&quot;, title = &quot;&quot;) + #Overall outcomes
  theme_lc +
  theme(legend.position = &quot;top&quot;)</code></pre>
