scen_values &lt;- setNames(lapply(seq_along(scen_keys), function(i) {
  land_consolidation_scenarios$y$net_benefit_lc_per_ha_MKes[
    land_consolidation_scenarios$x$Scenario == paste0(&quot;Scen_&quot;, i)]
}), scen_keys)
list2env(scen_values, envir = environment())</code></pre>
