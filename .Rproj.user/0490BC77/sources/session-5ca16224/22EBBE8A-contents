<pre class="r"><code>scenario_order &lt;- c(&quot;low_mp&quot;, &quot;med_mp&quot;, &quot;high_mp&quot;,
                     &quot;low_lp&quot;, &quot;med_lp&quot;, &quot;high_lp&quot;,
